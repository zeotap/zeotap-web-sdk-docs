        <summary type="html"><![CDATA[Features]]></summary>
        <content type="html"><![CDATA[<h3 class="anchor anchorWithStickyNavbar_LWe7" id="features">Features<a href="https://sdkdocs.zeotap.com/androidsdk/release-notes/v2.2.7#features" class="hash-link" aria-label="Direct link to Features" title="Direct link to Features">​</a></h3>
